# ==============================================================================
# RescuELINK — Autonomous Smart City Emergency Command System
# Production Environment Configuration Template
# ==============================================================================

# Google Gemini AI Key (Optional: Falls back automatically to Deterministic Heuristic Triage if unset)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Cryptographic Secret for Government Role HMAC-SHA256 Token Signing
SECRET_KEY=generate_a_secure_random_string_for_production_use

# Allowed CORS Origins (Comma-separated list; use * or specify production domain)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,*

# Path to built React Frontend static directory (Defaults to ../frontend/dist)
# FRONTEND_DIST_DIR=/app/frontend/dist
